# Playwright release smoke tests
# Copy to .env (never commit .env)

# App origin. Serve index.html first, e.g. npx serve -l 4173 .
BASE_URL=http://127.0.0.1:4173

# Primary trial / VIP-capable account with enough points (>= 20 recommended)
TEST_EMAIL=
TEST_PASSWORD=

# Optional paid VIP account (if different from TEST_EMAIL)
VIP_EMAIL=
VIP_PASSWORD=

# Expired membership account
EXPIRED_EMAIL=
EXPIRED_PASSWORD=

# Local import: audio is required. Subtitle defaults to tests/fixtures/sample.srt
TEST_AUDIO_PATH=
TEST_SUBTITLE_PATH=

# Set to 1 to run the live Edge ASR smoke (costs 10 points, needs DASHSCOPE)
TEST_RUN_LIVE_ASR=0
